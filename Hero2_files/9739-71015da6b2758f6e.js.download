    query EpisodeRatings_TitleData(
        $id: ID!
        $episodeRatingsNowDay: Int!
        $episodeRatingsNowMonth: Int!
        $episodeRatingsNowYear: Int!
    ) {
        title(id: $id) {
            ...EpisodeRatings_Spotlight
            # Keep this variable-dependent selection in the operation instead
            # of EpisodeRatings_Spotlight. Symphony combines page queries by
            # renaming operation variables, but it does not rename variables
            # referenced inside fragments. Moving these date variables into
            # the fragment would make the combined query invalid.
            episodes {
                episodes(
                    filter: {
                        releasedOnOrBefore: {
                            day: $episodeRatingsNowDay
                            month: $episodeRatingsNowMonth
                            year: $episodeRatingsNowYear
                        }
                        excludeSeasons: ["unknown"]
                    }
                    first: 1
                    sort: { by: RELEASE_DATE, order: DESC }
                ) {
                    edges {
                        node {
                            series {
                                displayableEpisodeNumber {
                                    displayableSeason {
                                        season
                                    }
                                    episodeNumber {
                                        episodeNumber
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    ${l}
