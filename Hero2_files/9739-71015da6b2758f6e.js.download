    query ProMetersBoxOffice {
        boxOfficeWeekendChart(limit: 5) {
            weekendStartDate
            weekendEndDate
            entries {
                title {
                    id
                    titleText {
                        text
                    }
                    primaryImage {
                        url
                    }
                    lifetimeGross(boxOfficeArea: DOMESTIC) {
                        total {
                            amount
                            currency
                        }
                    }
                }
                weekendGross {
                    total {
                        amount
                        currency
                    }
                }
            }
        }
    }
`,sG=(0,ey.ZP)`
    query ProMetersMovieMeter {
        chartTitles(first: 5, chart: { chartType: MOST_POPULAR_MOVIES }) {
            edges {
                currentRank
                node {
                    id
                    titleText {
                        text
                    }
                    primaryImage {
                        url
                    }
                    meterRanking {
                        currentRank
                        rankChange {
                            changeDirection
                            difference
                        }
                    }
                }
            }
        }
    }
`,sY=(0,ey.ZP)`
    query ProMetersStarMeter {
        chartNames(first: 5, chart: { chartType: MOST_POPULAR_NAMES }) {
            edges {
                currentRank
                node {
                    id
                    nameText {
                        text
                    }
                    primaryImage {
                        url
                    }
                    meterRanking {
                        currentRank
                        rankChange {
                            changeDirection
                            difference
                        }
                    }
                    knownForV2(limit: 1) {
                        credits {
                            title {
                                titleText {
                                    text
                                }
                            }
                        }
                    }
                }
            }
        }
    }
