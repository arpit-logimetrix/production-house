                                    url
                                    height
                                    width
                                    caption {
                                        plainText
                                    }
                                }
                            }
                            secondaryTitles {
                                titleText {
                                    text
                                }
                            }
                            secondaryCompanies {
                                companyText {
                                    text
                                }
                            }
                        }
                        ... on AwardedTitles {
                            __typename
                            titles {
                                id
                                titleText {
                                    text
                                }
                                primaryImage {
                                    url
                                    height
                                    width
                                    caption {
                                        plainText
                                    }
                                }
                            }
                            secondaryNames {
                                nameText {
                                    text
                                }
                            }
                            secondaryCompanies {
                                companyText {
                                    text
                                }
                            }
                        }
                    }
                }
            }
        }
    }
