    fragment InterestDiscussionCard on Interest {
        id
        primaryText {
            text
        }
        secondaryText {
            text
        }
        primaryImage {
            url
            width
            height
            caption {
                plainText
            }
        }
        engagementStatistics {
            followerStatistics {
                totalCount
            }
        }
    }
`;var s=a(65578);let o=(0,i.Ps)`
    fragment EpisodeRatings_Episode on Title {
        id
        titleText {
            text
        }
        primaryImage {
            url
            width
            height
            caption {
                plainText
            }
        }
        # Title.images defaults to useEntitlement: true; this is a consumer
        # surface, so read the public set.
        images(
            filter: { types: ["still_frame"] }
            first: 10
            useEntitlement: false
        ) {
            edges {
                node {
                    url
                    width
                    height
                    type
                    caption {
                        plainText
                    }
                }
            }
        }
        ratingsSummary {
            aggregateRating
            voteCount
        }
        canRate {
            isRatable
        }
        releaseDate {
            day
            month
            year
            displayableProperty {
                value {
                    plainText
                }
            }
        }
        plot {
            plotText {
                plaidHtml
                plainText
            }
        }
        series {
            nextEpisode {
                releaseDate {
                    day
                    month
                    year
                }
            }
            displayableEpisodeNumber {
                displayableSeason {
                    season
                }
                episodeNumber {
                    episodeNumber
                }
            }
        }
    }
`,l=(0,i.Ps)`
    fragment EpisodeRatings_Spotlight on Title {
        id
        titleText {
            text
        }
        originalTitleText {
            text
        }
        primaryImage {
            url
            width
            height
            caption {
                plainText
            }
        }
        ratingsSummary {
            aggregateRating
            voteCount
        }
        engagementStatistics {
            watchlistStatistics {
                displayableCount {
                    text
                }
                totalCount
            }
        }
        principalCredits(filter: { categories: ["cast", "creator"] }) {
            ...CreditRow
        }
        episodes {
            isOngoing
            displayableSeasons(first: 100) {
                total
                edges {
                    node {
                        season
                    }
                }
            }
        }
