iption":{"x-imdb-section":"Header","type":"string","description":"Optional subtitle below the heading"},"ctaUrl":{"x-imdb-section":"Header","type":"string","description":"Optional call-to-action link URL"},"dataSetType":{"x-imdb-section":"Data source","type":"string","enum":["topBoxOffice","listMostAnticipated","listTopRated","listTopBoxOffice","nameTopRatedCredits","custom"],"description":"Selects which query and builder pipeline to use. `custom` takes author-supplied title bars instead of a live query."},"valueType":{"x-imdb-section":"Custom dataset","type":"string","enum":["numeric","nominationCount","awardWinnerCount","rating","votes","watchlistCount","boxOffice"],"description":"What each bar\'s value represents. Author-entered types (numeric, nominationCount, awardWinnerCount) take a value per row; derived types (rating, votes, watchlistCount, boxOffice) pull the value from IMDb, so no value is entered."},"dataSetTitleItems":{"x-imdb-section":"Custom dataset","type":"array","minItems":2,"maxItems":10,"items":{"type":"object","properties":{"id":{"$ref":"#/definitions/titleConst"},"value":{"type":"number","minimum":0},"secondaryLabel":{"type":"string"}},"required":["id","value"]},"description":"Two to ten distinct titles (tt-prefixed), the non-negative value each bar shows, and an optional secondary label. Used for an author-entered valueType (numeric, nominationCount, awardWinnerCount)."},"dataSetTitleDerivedItems":{"x-imdb-section":"Custom dataset","type":"array","minItems":2,"maxItems":10,"items":{"type":"object","properties":{"id":{"$ref":"#/definitions/titleConst"},"secondaryLabel":{"type":"string"}},"required":["id"]},"description":"Two to ten distinct titles (tt-prefixed) and an optional secondary label — no value, since a derived valueType (rating, votes, watchlistCount, boxOffice) pulls each bar\'s value from IMDb."},"highlightNameId":{"x-imdb-section":"Custom dataset","$ref":"#/definitions/nameConst","description":"Optional person (nm-prefixed) to highlight on every title. The detail card then shows their still image and character name, like nameTopRatedCredits, instead of the title card."},"listId":{"x-imdb-section":"Data source","$ref":"#/definitions/listConst","description":"Required for listMostAnticipated, listTopRated, and listTopBoxOffice"},"nameId":{"x-imdb-section":"Data source","$ref":"#/definitions/nameConst","description":"Required for nameTopRatedCredits"},"limit":{"x-imdb-section":"Data filter","type":"integer","minimum":2,"maximum":10,"default":10,"description":"Maximum number of bars to display (2–10). Defaults to 10."},"excludeTitles":{"x-imdb-section":"Data filter","type":"array","items":{"$ref":"#/definitions/titleConst"},"description":"Title consts (tt-prefixed) to omit from the results. Excluded titles are dropped after the fetch, which is padded by the exclusion count so the chart still fills to the limit."},"cardDetailText":{"x-imdb-section":"Detail card","type":"string","description":"Optional bold line on the selected bar\'s card, replacing the card\'s built-in detail line. A card that shows a person\'s character name (nameTopRatedCredits, or a chart with highlightNameId) keeps it and shows this line too. Written like a Panther string, with the bar\'s number as value: {value, number} prints it in full, and {value, plural, one {# Emmy 2026 win} other {# Emmy 2026 wins}} pluralizes it. {formattedValue} prints the number the way the bar does, e.g. $95.2M for box office, so the text should not add its own $. Text that is not valid, or uses a variable other than value or formattedValue, is ignored."},"cardDetailUrl":{"x-imdb-section":"Detail card","type":"string","description":"Optional link for the detail line, used as written and the same for every bar (e.g. /event/ev0000223/2026/1/)."},"initialCardTitle":{"x-imdb-section":"Initial card","type":"string","description":"Title shown in the initial card before a bar is selected"},"initialCardDescription":{"x-imdb-section":"Initial card","type":"s