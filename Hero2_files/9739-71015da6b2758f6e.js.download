    query IndiaWidgetTrendingTitles(
        $numResults: Int!
        $input: TopTrendingPredefinedEnum!
    ) {
        topTrendingSetsPredefined(
            first: $numResults
            input: { topTrendingSetPredefined: $input }
        ) {
            edges {
                node {
                    ...TrendingTitle
                }
            }
        }
    }
    ${dS}
`,dw=(0,ey.ZP)`
