    query FreeTextCtaCallToAction($isLoggedIn: Boolean) {
        callToAction(context: { isLoggedIn: $isLoggedIn }) {
            landingPagePro {
                action {
                    label {
                        text
                    }
                    url
                }
                resultId
            }
